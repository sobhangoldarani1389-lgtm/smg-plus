{
  "name": "smg-plus",
  "productName": "SMG Plus",
  "version": "1.0.0",
  "description": "SMG Plus - یک صحنه‌ساز حرفه‌ای برای ترکیب چند Overlay در یک آدرس واحد برای OBS",
  "main": "electron/main.js",
  "author": "SMG",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir",
    "lint:syntax": "node --check server.js && node --check electron/main.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.smg.plus",
    "productName": "SMG Plus",
    "asar": true,
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "SMG-Plus-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SMG Plus",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "SMG-Plus-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sobhangoldarani1389-lgtm",
        "repo": "smg-plus",
        "releaseType": "release"
      }
    ]
  }
}